# Plantilla de variables de entorno.
#
# Copia este archivo como ".env" y rellena los valores reales.
# El archivo ".env" NUNCA se sube al repositorio (esta en .gitignore).

# Token del bot de Telegram. Te lo da @BotFather.
BOT_TOKEN=

# Ruta del archivo de base de datos SQLite.
DATABASE_PATH=./data/bot.sqlite

# Region de operacion.
COUNTRY=MX
DEFAULT_STATE=Oaxaca
TZ=America/Mexico_City

# Proveedor de rastreo (agregador) y su clave de API.
TRACKING_PROVIDER=aftership
TRACKING_API_KEY=

# Token de la API de Mercado Libre (opcional, para envios de Mercado Envios).
MERCADOLIBRE_ACCESS_TOKEN=

# Cada cuantos minutos se revisan los paquetes.
POLL_INTERVAL_MINUTES=30

# Nivel de detalle de los mensajes: debug | info | warn | error
LOG_LEVEL=info
