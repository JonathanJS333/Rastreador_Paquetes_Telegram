{
  // Configuración de TypeScript del proyecto.
  // Referencia: https://aka.ms/tsconfig
  "compilerOptions": {
    // Dónde está el código fuente y dónde se genera el JavaScript compilado.
    "rootDir": "./src",
    "outDir": "./dist",

    // Entorno de ejecución (Node.js).
    "module": "nodenext",
    "target": "esnext",
    "lib": ["esnext"],
    "types": ["node"],

    // Archivos de salida.
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Comprobaciones estrictas: más errores en el editor, menos errores en producción.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    // Necesarias para el sistema de módulos de Node.
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noUncheckedSideEffectImports": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
